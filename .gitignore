node_modules/
dist/
coverage/
*.tsbuildinfo

# The working corpus of reconstructions. Untracked on purpose, and destined for a
# repository of its own.
#
# Scenarios are data, not code: they accumulate one per case, they carry their own
# attribution from whichever investigation body published the source, and some of them
# will belong to a client rather than to the public. None of that should end up in the
# history of an MIT-licensed tool. What stays tracked is the single reference case under
# examples/, which is a regression test rather than a sample.
scenarios/*
!scenarios/README.md

# Local scratch: downloaded source PDFs, extraction working files.
# Reports are public, but we do not vendor them into the repo.
.scratch/
*.pdf

# What the player produces. A single recording outweighs the entire source tree,
# and git keeps it forever even after it is deleted.
*.webm
*.mp4

# Per-machine Claude Code permission overrides. Anything under .claude/skills/ is
# meant to be shared and stays tracked; this file is not.
.claude/settings.local.json

*.log
npm-debug.log*

.DS_Store
.vscode/
.idea/

.env
.env.local
