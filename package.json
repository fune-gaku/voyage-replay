{
  "name": "voyage-replay",
  "version": "0.0.0",
  "description": "Replay and reconstruct marine incidents in 3D - from overhead, your own bridge, or the other ship's",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fune-gaku/voyage-replay.git"
  },
  "keywords": [
    "maritime",
    "accident-reconstruction",
    "ais",
    "colreg",
    "3d",
    "replay"
  ],
  "scripts": {
    "// prepare": "Runs automatically after npm install. Points git at the version-controlled .githooks so the pre-commit secret scan needs no separate install step. Tolerant of failure because an install that dies where git is absent is worse than a missing local hook - CI scans as well.",
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "node scripts/build-single.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check:config": "node scripts/check-config.mjs",
    "check:secrets": "gitleaks git --no-banner --redact --exit-code 1 && gitleaks dir . --no-banner --redact --exit-code 1",
    "format": "prettier --write ."
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.0",
    "@types/three": "^0.185.3",
    "eslint": "^9.15.0",
    "prettier": "^3.4.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.16.0",
    "vite": "^6.0.3",
    "vitest": "^3.2.6"
  }
}
